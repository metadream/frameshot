{
    "name": "frame-shot",
    "productName": "FrameShot",
    "version": "2.0.0",
    "description": "Image Viewer and Duplicate Finder",
    "author": "Marco Chan",
    "repository": "github:metadream/frame-shot",
    "copyright": "Copyright (c) 2026",
    "license": "MIT",
    "type": "module",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "build:linux": "electron-builder -l",
        "build:win": "electron-builder -w",
        "build:mac": "electron-builder -m"
    },
    "build": {
        "appId": "frame-shot",
        "fileAssociations": [
            {
                "ext": [ "jpg", "jpeg", "png", "webp", "gif", "avif", "bmp", "svg", "heic", "heif", "tiff", "raw" ],
                "name": "Image Document",
                "description": "Image files",
                "role": "Viewer"
            }
        ],
        "win": {
            "target": [ "nsis" ],
            "icon": "assets/build/icon.ico"
        },
        "linux": {
            "target": [ "deb" ],
            "icon": "assets/build/icon.png",
            "mimeTypes": [ "image/*" ]
        },
        "mac": {
            "target": [ "dmg" ],
            "icon": "assets/build/icon.icns",
            "category": "public.app-category.utilities"
        }
    },
    "devDependencies": {
        "electron": "^39.2.2",
        "electron-builder": "^26.0.12"
    },
    "dependencies": {
        "heic-convert": "^2.1.0",
        "sharp": "^0.34.5"
    }
}
